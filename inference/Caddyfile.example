# Replace with a university-controlled hostname pointing to the inference host.
bylaw-model.example.edu {
    # Do not enable request-body or Authorization-header logging.
    @inference path /infer
    handle @inference {
        request_body {
            max_size 64KB
        }
        reverse_proxy 127.0.0.1:8787
    }
    handle {
        respond 404
    }
}
