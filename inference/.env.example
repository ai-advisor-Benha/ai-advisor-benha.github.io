# Copy OUTSIDE the public website checkout, e.g. /etc/bylaw/gateway.env.
# Generate a random secret of at least 32 characters. Never commit its real value.
GATEWAY_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
INFERENCE_PROVIDER=local
INFERENCE_URL=http://127.0.0.1:8080/v1/chat/completions
INFERENCE_MODEL=Qwen3-8B
# Optional token for the private inference server only:
INFERENCE_API_KEY=
ALLOW_REMOTE_INFERENCE=false
QUOTA_DB=/var/lib/bylaw/quota.sqlite
PORT=8787
MAX_CONCURRENT=2
MAX_PENDING=4
USER_CALLS_PER_MINUTE=12
USER_CALLS_PER_DAY=80
GLOBAL_CALLS_PER_DAY=240
