# Copy to a private directory OUTSIDE the GitHub Pages checkout as gateway.env.
# Remain on Groq Free. The gateway cannot determine your account's billing tier.
INFERENCE_PROVIDER=groq
INFERENCE_URL=https://api.groq.com/openai/v1/chat/completions
INFERENCE_MODEL=qwen/qwen3.8-27b
INFERENCE_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY
ALLOW_REMOTE_INFERENCE=true
GATEWAY_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
QUOTA_DB=./bylaw-quota.sqlite
PORT=8787
MAX_CONCURRENT=1
MAX_PENDING=4
USER_CALLS_PER_MINUTE=6
USER_CALLS_PER_DAY=40
GLOBAL_CALLS_PER_DAY=120
GLOBAL_TOKENS_PER_MINUTE=8000
GLOBAL_TOKENS_PER_DAY=200000
